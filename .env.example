# ProofStack Backend Configuration Example
# Copy to .env for local development

# Application
APP_NAME="ProofStack — AI Career Coach"
APP_VERSION="4.0.0"
DEBUG=false
RUN_MODE=deterministic # Options: "deterministic" (default, LLM-off) or "llm_assisted"
PUBLIC_BASE_URL=http://localhost:8000

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite+aiosqlite:///./proofstack.db

# Secrets & Security
APP_SESSION_SECRET=replace_with_32_bytes_random_secret_in_production
APP_ENC_KEY=replace_with_32_bytes_encryption_key_in_production

# GitHub Integration
# Fine-grained personal access token or GitHub App token (Read-only on repository contents)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Concurrency & Polling
POLL_INTERVAL_SECONDS=60
DEBOUNCE_SECONDS=5
MAX_FILE_BYTES=2097152 # 2 MB limit per file

# Optional LLM Candidate Verification
LLM_PROVIDER=none # Options: "none", "openai", "anthropic", "mock"
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Fallback LLM Settings
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
