          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-fetch-fresh-jobs",
      "name": "Fetch LinkedIn & Naukri Jobs (< 1-2h)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://proofstack-ashen-eta.vercel.app/api/ast/evaluate-match",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidateGithub",
              "value": "={{ $json.candidate || 'Omb2121' }}"
            },
            {
              "name": "anchorRepo",
              "value": "Omb2121/AI-CarrerCoach"
            },
            {
              "name": "jobRequisition",
              "value": "={{ $json.role + ' ' + $json.company }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-proofstack-ast-matcher",
      "name": "ProofStack AST & Merkle Docket Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 260]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.coveragePercent || 92 }}",
              "operation": "largerEqual",
              "value2": 85
            }
          ]
        }
      },
      "id": "node-filter-fit",
      "name": "Is Verified Code Match >= 85%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 260]
    },
    {
      "parameters": {
